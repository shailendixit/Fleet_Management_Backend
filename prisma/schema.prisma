// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model task_db {
  taskid            Int      @id @default(autoincrement())

  invoiceId    String?
  ordernumber       String?
  orty              String?
  linenum           Float?

  invoicedate       DateTime?
  invoicetime       String?

  quantity          Float?
  itemnumber2       String?

  description1      String?

  branchplant       String?

  shiptoname        String?

  address1          String?
  address2          String?

  postcode          String?
  city              String?

  routecode         String?

  actualship        DateTime?

  manifestnumber    String?

  weightuom         String?
  weight            Float?

  volumeuom         String?
  volume            Float?

  isassigned        Boolean  @default(false)

  @@index([taskid])
}

enum Status {
  available
  unavailable
}



model Driver_Db {
  driverId          Int      @id @default(autoincrement())
  truckNo     Int?
  cubic       Float?   @map("Cubic (m3)")
  driverName  String?  @map("Drivers Name")
  truckType   String?  @map("Truck")
  status      Status   @default(available)
  username    String?  @unique
  password    String?
  TrackerID     Int?     @unique
}
model User_Db {
  id          Int      @id @default(autoincrement())
  username    String   @unique
  email       String   @unique
  password    String
  role     String     @default("admin")
}


model AssignedTask_DB {
  assignedTaskId    Int      @id @default(autoincrement())
  taskId            Int      @unique

  invoiceId         String?
  ordernumber       String?
  orty              String?
  linenum           Float?

  invoicedate       DateTime?
  invoicetime       String?

  quantity          Float?
  itemnumber2       String?
  description1      String?

  branchplant       String?
  shiptoname        String?

  address1          String?
  address2          String?

  postcode          String?
  city              String?

  routecode         String?

  actualship        DateTime?

  manifestnumber    String?

  weightuom         String?
  weight            Float?

  volumeuom         String?
  volume            Float?

  // driver assignment fields (unchanged)
  TrackerID         Int?
  truckNo           Int?
  cubic             Float?   @map("Cubic (m3)")
  driverName        String?  @map("Drivers Name")
  truckType         String?  @map("Truck")

  status            String?  @default("Not Started")
  assignedAt        DateTime @default(now())

  isCompleted       Boolean  @default(false)
  isAttemptedToComplete Boolean  @default(false)

  @@index([ordernumber])
  @@index([assignedTaskId])
  @@index([invoiceId])
}

model CompletedTask_DB {
  completedTaskId   Int      @id @default(autoincrement())
  taskId            Int      @unique

  invoiceId         String?
  ordernumber       String?
  orty              String?
  linenum           Float?

  invoicedate       DateTime?
  invoicetime       String?

  quantity          Float?
  itemnumber2       String?
  description1      String?

  branchplant       String?
  shiptoname        String?

  address1          String?
  address2          String?

  postcode          String?
  city              String?

  routecode         String?

  actualship        DateTime?

  manifestnumber    String?

  weightuom         String?
  weight            Float?

  volumeuom         String?
  volume            Float?

  truckNo           Int?
  driverName        String?  @map("Drivers Name")
  assignedAt        DateTime @default(now())

  manifestNo        String?

  POD               String?
  InvoiceImage      String?
  PodImage          String?

  completedAt       DateTime @default(now())
}